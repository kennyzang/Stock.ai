  {
   "id": "A_N",
   "t0": 18.715,
   "t1": 20.437,
   "text": "A loss can turn out to be lucky."
  },
  {
   "id": "U_M",
   "t0": 20.637,
   "t1": 23.07,
   "text": "塞翁失马，焉知非福。"
