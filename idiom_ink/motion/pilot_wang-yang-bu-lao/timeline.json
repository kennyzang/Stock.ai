  {
   "id": "A_N",
   "t0": 17.972,
   "t1": 20.124,
   "text": "It's never too late to fix it."
  },
  {
   "id": "U_M",
   "t0": 20.324,
   "t1": 22.818,
   "text": "亡羊补牢，为时未晚。"
